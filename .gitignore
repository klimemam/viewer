__pycache__/
*.pyc
.venv/
venv/
build/
tools/testdata/
build-mingw/
# hello_imgui window-layout settings written next to imgui_demo.py
*.ini
build-verify/
build-dbg/
# a Release tree configured with -D_GLIBCXX_ASSERTIONS: the libstdc++ container
# preconditions (vector::operator[] in range, iterators valid) checked at run
# time. It is where a subscript one past the end of a buffer stops being
# invisible - Release does not check, so such a defect passes the whole suite.
build-hard/
*.egg-info/
build-board/
# The headless bench gate's log (.github/workflows/build.yml, "Headless render +
# frame-time check" tees it here and greps it for the frame-time verdict). It is
# ignored rather than merely untracked because the compat build that runs after
# it asks cmake/gitversion.cmake whether the tree is clean, and an untracked file
# at the root is a modification as far as `git status --porcelain` is concerned -
# which would stamp every shipped Linux binary "<hash>+local" and stop it naming
# the commit it was built from.
bench.log

# tools/run_selftests.sh files a failing test's output here, one file per test.
# Untracked on purpose: it is written automatically and unreviewed, and a 200 kB
# ctest log must never arrive in a commit by accident. What gets COMMITTED to
# docs/diagnostics/ is a human's trim of one of these, down to the signature.
docs/diagnostics/auto/

# agent worktrees (created and removed per task; never part of a commit)
viewer_work/
